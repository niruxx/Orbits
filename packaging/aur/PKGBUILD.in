# Generated from the release archive by packaging/build-release.py.
pkgname=orbits
pkgver=@VERSION@
pkgrel=1
pkgdesc='Wallpapers, fonts, themes, desktop Looks and GDM login screen manager'
arch=('any')
url='https://github.com/niruxx/Orbits'
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'bubblewrap' 'python-pillow' 'python-fonttools' 'fontconfig' 'polkit' 'dconf' 'gsettings-desktop-schemas')
makedepends=('meson' 'ninja' 'gettext')
optdepends=('minisign: pinned publisher verification' 'gdm: login screen customization' 'gnome-shell: Shell themes and greeter previews' 'xfconf: XFCE desktop support' 'xdg-desktop-portal: screenshots')
source=("$url/releases/download/v$pkgver/orbits-$pkgver.tar.xz")
sha256sums=('@SHA256@')
install=orbits.install

build() { arch-meson "orbits-$pkgver" build; meson compile -C build; }
check() { meson test -C build --print-errorlogs; }
package() { DESTDIR="$pkgdir" meson install -C build; }
