# Maintainer: niruxx
# Builds from the local source tree:  cd packaging/arch && makepkg -si
pkgname=orbits
pkgver=0.3.0
pkgrel=15
pkgdesc="GTK4 manager for wallpapers, fonts, themes, app colors, desktop Looks and the GDM login screen"
arch=('any')
url="https://github.com/niruxx/Orbits"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'glib2' 'gdk-pixbuf2' 'pango'
         'bubblewrap' 'python-pillow' 'python-fonttools' 'fontconfig' 'polkit' 'dconf' 'gsettings-desktop-schemas')
optdepends=('clamav: optional malware scanning and virus definition updates' 'minisign: pinned publisher verification' 'xdg-desktop-portal: desktop screenshots for saved Looks'
            'gtk3: Plymouth X11 renderer runtime'
            'python-pillow-heif: HEIC and multi-frame dynamic wallpaper import'
            'gdm: login screen customization'
            'gnome-shell: login and lock screen theming'
            'gnome-shell-extensions: User Themes extension for Shell themes'
            'plymouth: boot splash themes'
            'xfconf: XFCE appearance support')
makedepends=('gettext')
install=orbits.install

_srcroot="$(realpath "${startdir}/../..")"

pkgver() {
  python -c "import ast,sys; t=open(sys.argv[1]).read(); print([n.value.value for n in ast.parse(t).body if isinstance(n, ast.Assign) and n.targets[0].id == 'VERSION'][0])" \
    "${_srcroot}/orbits/__init__.py"
}

build() {
  rm -rf "${srcdir}/orbits" "${srcdir}/tests" "${srcdir}/po" "${srcdir}/packaging"
  cp -r "${_srcroot}/orbits" "${_srcroot}/tests" "${_srcroot}/po" "${srcdir}/"
  install -Dm644 "${_srcroot}/packaging/build-release.py" "${srcdir}/packaging/build-release.py"
  find "${srcdir}" -name '__pycache__' -prune -exec rm -rf {} +
}

check() {
  cd "${srcdir}"
  sh tests/run.sh
}

package() {
  local id=io.github.niruxx.Orbits
  install -dm755 "${pkgdir}/usr/lib/orbits"
  cp -r "${srcdir}/orbits" "${pkgdir}/usr/lib/orbits/"
  find "${pkgdir}/usr/lib/orbits" -type f -exec chmod 644 {} +
  chmod 755 "${pkgdir}/usr/lib/orbits/orbits/gdm/helper.py"
  python -m compileall -q -o 0 -o 1 -d /usr/lib/orbits "${pkgdir}/usr/lib/orbits"

  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/orbits" <<'LAUNCHER'
#!/usr/bin/python3 -P
import sys
sys.path.insert(0, "/usr/lib/orbits")
from orbits.entry import main
sys.exit(main())
LAUNCHER

  sed "s|@EXEC@|orbits|" "${_srcroot}/data/${id}.desktop.in" > "${srcdir}/${id}.desktop"
  install -Dm644 "${srcdir}/${id}.desktop" "${pkgdir}/usr/share/applications/${id}.desktop"
  install -Dm644 "${_srcroot}/data/icons/hicolor/scalable/apps/${id}.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/${id}.svg"
  install -Dm644 "${_srcroot}/data/${id}.policy" "${pkgdir}/usr/share/polkit-1/actions/${id}.policy"
  install -Dm644 "${_srcroot}/data/${id}.metainfo.xml" "${pkgdir}/usr/share/metainfo/${id}.metainfo.xml"
  install -Dm644 "${_srcroot}/data/${id}.search-provider.ini" "${pkgdir}/usr/share/gnome-shell/search-providers/${id}.search-provider.ini"
  sed "s|@EXEC@|/usr/bin/orbits|" "${_srcroot}/data/${id}.SearchProvider.service.in" > "${srcdir}/${id}.SearchProvider.service"
  install -Dm644 "${srcdir}/${id}.SearchProvider.service" "${pkgdir}/usr/share/dbus-1/services/${id}.SearchProvider.service"
  install -Dm644 "${_srcroot}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -dm755 "${pkgdir}/usr/share/locale/es/LC_MESSAGES"
  msgfmt "${_srcroot}/po/es.po" -o "${pkgdir}/usr/share/locale/es/LC_MESSAGES/orbits.mo"
  install -Dm644 "${_srcroot}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
